CompileFlags:
  CompilationDatabase: build
  Add:
    - "-Wall"
    - "-Wextra"
    - "-std=c++23"
    - "-I/usr/share/R/include"

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - cert-*
      - cppcoreguidelines-*
      - misc-*
      - modernize-*
      - performance-*
      - readability-*
    Remove:
      - cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
      - cppcoreguidelines-pro-bounds-pointer-arithmetic
      - cppcoreguidelines-pro-bounds-constant-array-index
      - cppcoreguidelines-avoid-do-while
      - readability-trailing-comma
      - misc-non-private-member-variables-in-classes
      - readability-implicit-bool-conversion
      - misc-no-recursion
      - readability-function-cognitive-complexity
      - readability-avoid-nested-conditional-operator
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - cppcoreguidelines-avoid-magic-numbers
      - readability-magic-numbers
      - readability-braces-around-statements
      - cppcoreguidelines-avoid-non-const-global-variables
      - cppcoreguidelines-owning-memory
      - bugprone-easily-swappable-parameters
      - cppcoreguidelines-pro-type-union-access
      - cppcoreguidelines-pro-type-vararg
      - misc-use-internal-linkage
    CheckOptions:
      misc-include-cleaner.IgnoreHeaders: '(^|.*/)bits/.*'
  UnusedIncludes: Strict

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

---
If:
  PathMatch: '(.*/)?include/ibex/plugin/schema\.hpp'
CompileFlags:
  # clangd otherwise infers this header's command from src/ir/schema.cpp,
  # whose target does not use the plugin's header-only JSON dependency.
  # The inferred command's working directory is build/.
  Add: [-isystem, ../build/_deps/nlohmann_json-src/include]

---
If:
  PathMatch: [.*/_deps/.*, .*/build/.*]
Diagnostics:
  Suppress: '*'
CompileFlags:
  Add: [-w]

---
If:
  PathMatch:
    - '.*/tests/.*\.cpp'
    - '.*/test_[^/]*\.cpp'
    - '.*/_[^/]*_test\.cpp'
Diagnostics:
  Suppress:
    - misc-use-anonymous-namespace
  ClangTidy:
    Remove:
      - cppcoreguidelines-avoid-do-while
      - cppcoreguidelines-avoid-non-const-global-variables
      - cppcoreguidelines-pro-type-vararg
      - cppcoreguidelines-owning-memory
      - cppcoreguidelines-special-member-functions
      - cert-err58-cpp
      - misc-use-anonymous-namespace
      - bugprone-exception-escape
      - readability-function-cognitive-complexity
