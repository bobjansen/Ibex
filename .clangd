CompileFlags:
  CompilationDatabase: build
  Add:
    - "-Wall"
    - "-Wextra"
    - "-std=c++23"
    - "-I/usr/share/R/include"

Diagnostics:
  # The clang-tidy checks come from .clang-tidy, which clangd reads too. A
  # second list here drifted from it (it still enabled checks .clang-tidy
  # turns off), so the editor showed lints CI never reports.
  # clangd's own include diagnostics stand in for misc-include-cleaner in the
  # editor; ignore the same libstdc++ implementation headers it ignores.
  Includes:
    IgnoreHeader: ['bits/.*']
  UnusedIncludes: Strict

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

---
If:
  PathMatch: '(.*/)?include/ibex/plugin/schema\.hpp'
CompileFlags:
  # clangd otherwise infers this header's command from src/ir/schema.cpp,
  # whose target does not use the plugin's header-only JSON dependency.
  # The inferred command's working directory is build/.
  Add: [-isystem, ../build/_deps/nlohmann_json-src/include]

---
If:
  PathMatch: [.*/_deps/.*, .*/build/.*]
Diagnostics:
  Suppress: '*'
CompileFlags:
  Add: [-w]

---
If:
  PathMatch:
    - '.*/tests/.*\.cpp'
    - '.*/test_[^/]*\.cpp'
    - '.*/_[^/]*_test\.cpp'
Diagnostics:
  Suppress:
    - misc-use-anonymous-namespace
  ClangTidy:
    Remove:
      - cppcoreguidelines-avoid-do-while
      - cppcoreguidelines-avoid-non-const-global-variables
      - cppcoreguidelines-pro-type-vararg
      - cppcoreguidelines-owning-memory
      - cppcoreguidelines-special-member-functions
      - cert-err58-cpp
      - misc-use-anonymous-namespace
      - bugprone-exception-escape
      - readability-function-cognitive-complexity
