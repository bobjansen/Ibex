#!/usr/bin/env bash
# Pre-commit: run clang-format on staged C++ files and fail if formatting changes.

set -euo pipefail

# The pinned clang-format, through the same wrapper CI's version comes from.
FORMAT="$(git rev-parse --show-toplevel)/scripts/clang-format.sh"
HAVE_FORMAT=1
if ! "$FORMAT" --version >/dev/null 2>&1; then
    HAVE_FORMAT=0
    echo "warning: the pinned clang-format is not installed; skipping format check" >&2
    echo "         (run scripts/clang-format.sh --version for the install command)" >&2
fi

FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cpp' '*.hpp' || true)
if [[ -z "${FILES}" ]]; then
    "$(git rev-parse --show-toplevel)"/scripts/check-bundled-io-imports.sh
    exit 0
fi

FAILED=0
if [[ "$HAVE_FORMAT" -eq 1 ]]; then
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        "$FORMAT" -i "$file"
        git add "$file"
        if ! "$FORMAT" --dry-run --Werror "$file"; then
            FAILED=1
        fi
    done <<< "$FILES"
fi

if [[ "$FAILED" -ne 0 ]]; then
    echo "error: clang-format check failed. Run clang-format on the files above." >&2
    exit 1
fi

"$(git rev-parse --show-toplevel)"/scripts/check-bundled-io-imports.sh
