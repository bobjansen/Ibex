+namespace {
+// Counts are already shifted to the caller's destination bins. Keep source
+// bounds and validity dispatch outside the row loop, away from captured state
+// in the general aggregate evaluator.
+IBEX_NOINLINE void count_collect_groups(const std::uint32_t* groups, std::size_t begin,
+                                        std::size_t end, const ValidityBitmap* validity,
+                                        std::size_t* counts) noexcept {
+    if (validity == nullptr) {
+        for (std::size_t row = begin; row < end; ++row) {
+            ++counts[groups[row]];
+        }
+    } else {
+        for (std::size_t row = begin; row < end; ++row) {
+            if ((*validity)[row]) {
+                ++counts[groups[row]];
+            }
+        }
+    }
+}
+template <typename T>
+IBEX_NOINLINE void scatter_collect_values(const T* values, const std::uint32_t* groups,
+                                          std::size_t begin, std::size_t end,
+                                          const ValidityBitmap* validity, std::size_t* next,
+                                          double* output) noexcept {
+    if (validity == nullptr) {
+        for (std::size_t row = begin; row < end; ++row) {
+            output[next[groups[row]]++] = static_cast<double>(values[row]);
+        }
+    } else {
+        for (std::size_t row = begin; row < end; ++row) {
+            if ((*validity)[row]) {
+                output[next[groups[row]]++] = static_cast<double>(values[row]);
+            }
+        }
+    }
+}
+}  // namespace
