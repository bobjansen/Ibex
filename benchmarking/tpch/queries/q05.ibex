// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q5 — Local Supplier Volume
//
//  6-table equijoin chain + group-by + order. The real stress test: existing
//  Ibex join benchmarks only exercise up to 4-table chains. Standard TPC-H
//  qualification parameters: REGION='ASIA', DATE='1994-01-01'; the "+
//  interval '1' year" bound is a fixed constant (1995-01-01), inlined as a
//  literal Date. Reads Parquet (converted once via convert_to_parquet.ibex),
//  matching what Polars' own PDS-H benchmark scans.
//
//  Supplier locality is expressed directly as a two-column hash join on
//  (supplier key, nation key), avoiding a larger supplier join followed by a
//  post-join equality filter.
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q05.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";
extern fn write_csv(df: DataFrame, path: String) -> Int from "csv.hpp";

let region = read_parquet("benchmarking/data/tpch/parquet/region.parquet") as DataFrame<{
    r_regionkey: Int64,
    r_name: String
}>;
let nation = read_parquet("benchmarking/data/tpch/parquet/nation.parquet") as DataFrame<{
    n_nationkey: Int64,
    n_name: String,
    n_regionkey: Int64
}>;
let customer = read_parquet("benchmarking/data/tpch/parquet/customer.parquet") as DataFrame<{
    c_custkey: Int64,
    c_nationkey: Int64
}>;
let orders = read_parquet("benchmarking/data/tpch/parquet/orders.parquet") as DataFrame<{
    o_orderkey: Int64,
    o_custkey: Int64,
    o_orderdate: Date
}>;
let lineitem = read_parquet("benchmarking/data/tpch/parquet/lineitem.parquet") as DataFrame<{
    l_orderkey: Int64,
    l_suppkey: Int64,
    l_extendedprice: Float64,
    l_discount: Float64
}>;
let supplier = read_parquet("benchmarking/data/tpch/parquet/supplier.parquet") as DataFrame<{
    s_suppkey: Int64,
    s_nationkey: Int64
}>;

// Match the PDS Polars chain: region → nation → customer → orders → lineitem
// → supplier, with filters applied to the joined relation.
let result = (
    (((((region join nation on { r_regionkey = n_regionkey })
        join customer on { n_nationkey = c_nationkey })
        join orders on { c_custkey = o_custkey })
        join lineitem on { o_orderkey = l_orderkey })
        join supplier on { l_suppkey = s_suppkey, n_nationkey = s_nationkey })[
    filter r_name == "ASIA" && o_orderdate >= date"1994-01-01"
        && o_orderdate < date"1995-01-01",
    select { revenue = sum(l_extendedprice * (1.0 - l_discount)) },
    by { n_name }
][
    order { revenue desc }
]);
write_csv(result, "benchmarking/data/tpch/out/q05.csv");
result;
