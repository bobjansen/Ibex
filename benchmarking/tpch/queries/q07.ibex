// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q7 — Volume Shipping
//
//  Revenue on goods shipped between two nations, by year and direction.
//  Standard TPC-H qualification parameters: NATION1='FRANCE', NATION2='GERMANY',
//  shipped in 1995-1996.
//
//  Six tables: supplier and customer each carry a nation (the two `nation`
//  aliases n1/n2 in the SQL). Both nation views are restricted to France and
//  Germany before entering the fact-table chain; the final `OR` then keeps
//  only the two cross-country directions.
//
//  The join chain deliberately starts with customer + its filtered nation.
//  q07 has six relations, beyond the planner's conservative automatic-reorder
//  limit, so source order matters: this applies the selective two-nation edge
//  before orders and lineitem instead of building a large fact-table
//  intermediate and filtering it near the end.
//  `l_year` is `year(l_shipdate)`, materialized with `update` before the `by`
//  because a group key must be a bare column.
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q07.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";
extern fn write_csv(df: DataFrame, path: String) -> Int from "csv.hpp";

let customer = read_parquet("benchmarking/data/tpch/parquet/customer.parquet") as DataFrame<{
    c_custkey: Int64,
    c_nationkey: Int64
}>;
let nations = read_parquet("benchmarking/data/tpch/parquet/nation.parquet") as DataFrame<{
    n_nationkey: Int64,
    n_name: String
}>[
    filter n_name == "FRANCE" || n_name == "GERMANY"
];
let orders = read_parquet("benchmarking/data/tpch/parquet/orders.parquet") as DataFrame<{
    o_orderkey: Int64,
    o_custkey: Int64
}>;
let lineitem = read_parquet("benchmarking/data/tpch/parquet/lineitem.parquet") as DataFrame<{
    l_orderkey: Int64,
    l_suppkey: Int64,
    l_extendedprice: Float64,
    l_discount: Float64,
    l_shipdate: Date
}>;
let supplier = read_parquet("benchmarking/data/tpch/parquet/supplier.parquet") as DataFrame<{
    s_suppkey: Int64,
    s_nationkey: Int64
}>;

// Match Polars: customer → customer nation → orders → lineitem → supplier →
// supplier nation, with both nation and ship-date predicates applied late.
let joined = (((((customer join nations[
    select { c_nationkey = n_nationkey, cust_nation = n_name }
] on { c_nationkey = c_nationkey })
    join orders on { c_custkey = o_custkey })
    join lineitem on { o_orderkey = l_orderkey })
    join supplier on { l_suppkey = s_suppkey })
    join nations[
        select { s_nationkey = n_nationkey, supp_nation = n_name }
    ] on { s_nationkey = s_nationkey });

let result = joined[
    filter ((supp_nation == "FRANCE" && cust_nation == "GERMANY")
        || (supp_nation == "GERMANY" && cust_nation == "FRANCE"))
        && l_shipdate >= date"1995-01-01" && l_shipdate <= date"1996-12-31"
][
    update { l_year = year(l_shipdate) }
][
    select { revenue = sum(l_extendedprice * (1.0 - l_discount)) },
    by { supp_nation, cust_nation, l_year }
][order { supp_nation, cust_nation, l_year }];
write_csv(result, "benchmarking/data/tpch/out/q07.csv");
result;
