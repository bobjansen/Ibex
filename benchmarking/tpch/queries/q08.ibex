// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q8 — National Market Share
//
//  One nation's share of its region's market for a part type, by year. Standard
//  TPC-H qualification parameters: NATION='BRAZIL', REGION='AMERICA',
//  TYPE='ECONOMY ANODIZED STEEL', orders in 1995-1996.
//
//  Eight tables. Nation appears twice, in different roles: the CUSTOMER's nation
//  reaches region (the market is "orders from customers in AMERICA"), while the
//  SUPPLIER's nation names who filled the order (the numerator is "supplied from
//  BRAZIL"). They are joined separately, so both stay plain equijoins.
//
//  mkt_share = supplied-from-BRAZIL revenue / total revenue, per year. The
//  numerator's `case when nation = 'BRAZIL' then volume else 0` is
//  `volume * Int64(supp_nation == "BRAZIL")`, and the ratio of the two sums
//  rides the post-aggregate path (as q17/q14 do).
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q08.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";
extern fn write_csv(df: DataFrame, path: String) -> Int from "csv.hpp";

let part = read_parquet("benchmarking/data/tpch/parquet/part.parquet") as DataFrame<{
    p_partkey: Int64,
    p_type: String
}>;
let lineitem = read_parquet("benchmarking/data/tpch/parquet/lineitem.parquet") as DataFrame<{
    l_orderkey: Int64,
    l_partkey: Int64,
    l_suppkey: Int64,
    l_extendedprice: Float64,
    l_discount: Float64
}>;
let supplier = read_parquet("benchmarking/data/tpch/parquet/supplier.parquet") as DataFrame<{
    s_suppkey: Int64,
    s_nationkey: Int64
}>;
let orders = read_parquet("benchmarking/data/tpch/parquet/orders.parquet") as DataFrame<{
    o_orderkey: Int64,
    o_custkey: Int64,
    o_orderdate: Date
}>;
let customer = read_parquet("benchmarking/data/tpch/parquet/customer.parquet") as DataFrame<{
    c_custkey: Int64,
    c_nationkey: Int64
}>;
let nation = read_parquet("benchmarking/data/tpch/parquet/nation.parquet") as DataFrame<{
    n_nationkey: Int64,
    n_name: String,
    n_regionkey: Int64
}>;
let n1 = nation[select { c_nationkey = n_nationkey, n_regionkey }];
let n2 = nation[select { s_nationkey = n_nationkey, supp_nation = n_name }];
let region = read_parquet("benchmarking/data/tpch/parquet/region.parquet") as DataFrame<{
    r_regionkey: Int64,
    r_name: String
}>;

// Match Polars: part → lineitem → supplier → orders → customer → n1 → region,
// then the supplier-nation join and late date/type predicates.
let regional = ((((((part join lineitem on { p_partkey = l_partkey })
    join supplier on { l_suppkey = s_suppkey })
    join orders on { l_orderkey = o_orderkey })
    join customer on { o_custkey = c_custkey })
    join n1 on { c_nationkey = c_nationkey })
    join region on { n_regionkey = r_regionkey })[
    filter r_name == "AMERICA"
];

let joined = (regional join n2 on { s_nationkey = s_nationkey })[
    filter o_orderdate >= date"1995-01-01" && o_orderdate <= date"1996-12-31"
        && p_type == "ECONOMY ANODIZED STEEL"
];

let result = joined[
    update { o_year = year(o_orderdate) }
][
    select {
        mkt_share =
            sum(l_extendedprice * (1.0 - l_discount) * Int64(supp_nation == "BRAZIL"))
            / sum(l_extendedprice * (1.0 - l_discount))
    },
    by { o_year }
][order { o_year }];
write_csv(result, "benchmarking/data/tpch/out/q08.csv");
result;
