// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q9 — Product Type Profit Measure
//
//  6-table equijoin + a string pattern filter + a two-key join. The part
//  filter is `p_name like '%green%'`, which is what `like(...)` exists for
//  (SPEC 12.6, "String Pattern Matching"); before it, this query had no
//  spelling in Ibex at all.
//
//  `partsupp` is joined on BOTH keys — `on { l_partkey, l_suppkey }` — since
//  a supply cost is per (part, supplier) pair. A single-key join here would
//  silently fan out the row count and inflate the profit.
//
//  The filtered `part` (~10.6k of 200k rows) leads the chain on purpose, so
//  the 6M-row lineitem scan probes a small build side, and every later join
//  works on the already-narrowed stream.
//
//  Group keys are `n_name` and the derived `o_year`; a `by` clause needs
//  columns, so the year is materialized in an `update` before the group-by.
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q09.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";
extern fn write_csv(df: DataFrame, path: String) -> Int from "csv.hpp";

let part = read_parquet("benchmarking/data/tpch/parquet/part.parquet") as DataFrame<{
    p_partkey: Int64,
    p_name: String
}>;
let partsupp = read_parquet("benchmarking/data/tpch/parquet/partsupp.parquet") as DataFrame<{
    ps_partkey: Int64,
    ps_suppkey: Int64,
    ps_supplycost: Float64
}>;
let supplier = read_parquet("benchmarking/data/tpch/parquet/supplier.parquet") as DataFrame<{
    s_suppkey: Int64,
    s_nationkey: Int64
}>;
let lineitem = read_parquet("benchmarking/data/tpch/parquet/lineitem.parquet") as DataFrame<{
    l_orderkey: Int64,
    l_partkey: Int64,
    l_suppkey: Int64,
    l_quantity: Float64,
    l_extendedprice: Float64,
    l_discount: Float64
}>;
let orders = read_parquet("benchmarking/data/tpch/parquet/orders.parquet") as DataFrame<{
    o_orderkey: Int64,
    o_orderdate: Date
}>;
let nation = read_parquet("benchmarking/data/tpch/parquet/nation.parquet") as DataFrame<{
    n_nationkey: Int64,
    n_name: String
}>;

// Match Polars: part → partsupp → supplier → lineitem (composite key) →
// orders → nation, with the green-part predicate applied after the chain.
let profit = (((((part join partsupp on { p_partkey = ps_partkey })
    join supplier on { ps_suppkey = s_suppkey })
    join lineitem on { p_partkey = l_partkey, ps_suppkey = l_suppkey })
    join orders on { l_orderkey = o_orderkey })
    join nation on { s_nationkey = n_nationkey })[
    filter like(p_name, "%green%")
];

let result = profit[
    update {
        o_year = year(o_orderdate),
        nation = n_name,
        amount = l_extendedprice * (1.0 - l_discount) - ps_supplycost * l_quantity
    }
][
    select { sum_profit = sum(amount) },
    by { nation, o_year }
][
    order { nation asc, o_year desc }
];
write_csv(result, "benchmarking/data/tpch/out/q09.csv");
result;
