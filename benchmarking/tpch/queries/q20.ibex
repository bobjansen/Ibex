// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q20 — Potential Part Promotion
//
//  Suppliers in a nation who hold more of a "forest…" part than half of what
//  they shipped of it in 1994 — i.e. surplus stock worth promoting. Standard
//  TPC-H qualification parameters: COLOR='forest', DATE='1994-01-01',
//  NATION='CANADA'.
//
//  The benchmark follows the explicit relational shape used by Polars: build
//  the filtered line-item aggregate and nation/supplier relation first, then
//  join parts, partsupp, the aggregate, and suppliers in that order. This keeps
//  the engine comparison about execution rather than a correlated-subquery
//  lowering choice.
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q20.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";
extern fn write_csv(df: DataFrame, path: String) -> Int from "csv.hpp";

let supplier_raw = read_parquet("benchmarking/data/tpch/parquet/supplier.parquet");
let nation_raw = read_parquet("benchmarking/data/tpch/parquet/nation.parquet");
let partsupp_raw = read_parquet("benchmarking/data/tpch/parquet/partsupp.parquet");
let part_raw = read_parquet("benchmarking/data/tpch/parquet/part.parquet");
let lineitem_raw = read_parquet("benchmarking/data/tpch/parquet/lineitem.parquet");

// Follow the explicit relational shape used by Polars: materialize the
// line-item aggregate, the filtered nation, and the supplier/nation join, then
// join those relations in the final chain. This keeps q20's benchmark shape
// comparable across engines instead of hiding the work in a correlated scalar
// and two semi joins.
let q1 = lineitem_raw[
    filter l_shipdate >= date"1994-01-01" && l_shipdate < date"1995-01-01",
    select { l_partkey, l_suppkey, sum_quantity = 0.5 * sum(l_quantity) },
    by { l_partkey, l_suppkey }
];

let q2 = nation_raw[filter n_name == "CANADA"][select { n_nationkey }];

let q3 = supplier_raw[
    select { s_suppkey, s_name, s_address, s_nationkey }
] join q2 on { s_nationkey = n_nationkey };

let forest_parts = part_raw[filter like(p_name, "forest%")][
    select { ps_partkey = p_partkey }
][distinct { ps_partkey }];

let result = (
    (
        (forest_parts join partsupp_raw on { ps_partkey })
        join q1 on { ps_partkey = l_partkey, ps_suppkey = l_suppkey }
    )[
        filter Float64(ps_availqty) > sum_quantity
    ][select { ps_suppkey }][distinct { ps_suppkey }]
    join q3 on { ps_suppkey = s_suppkey }
)[select { s_name, s_address }][order { s_name }];
write_csv(result, "benchmarking/data/tpch/out/q20.csv");
result;
