// ─────────────────────────────────────────────────────────────────────────────
//  PDS-H / TPC-H Q21 — Suppliers Who Kept Orders Waiting
//
//  Suppliers in a nation who were the sole reason a multi-supplier order shipped
//  late: their own line arrived after its commit date, and no other supplier on
//  that order was also late. Standard TPC-H qualification: NATION='SAUDI ARABIA'.
//
//  The SQL correlates two subqueries on an INEQUALITY (l_suppkey <> l1.l_suppkey),
//  which a semi join cannot express directly. The exact set-based rewrite turns
//  both into per-order DISTINCT-supplier counts:
//
//    - `exists (l2 … l_suppkey <> l1.l_suppkey)` — "another supplier is on this
//      order" — holds iff the order has MORE THAN ONE distinct supplier.
//    - `not exists (l3 … different supplier AND late)` — "no other supplier was
//      also late" — holds iff the order has EXACTLY ONE distinct late supplier,
//      which must be l1's own (l1 is late by the outer filter).
//
//  l1 stays at line granularity (one row per late line), so count() counts
//  waiting lines, matching the SQL.
//
//  Run:
//    ./build-release/tools/ibex_eval --plugin-path build-release/tools \
//        benchmarking/tpch/queries/q21.ibex
// ─────────────────────────────────────────────────────────────────────────────

extern fn parquet::read(path: String) -> DataFrame from "parquet.hpp";
extern fn csv::write(df: DataFrame, path: String) -> Int from "csv.hpp";

let supplier_raw = parquet::read("benchmarking/data/tpch/parquet/supplier.parquet") as DataFrame<{
    s_suppkey: Int64,
    s_name: String,
    s_nationkey: Int64
}>;
let nation_raw = parquet::read("benchmarking/data/tpch/parquet/nation.parquet") as DataFrame<{
    n_nationkey: Int64,
    n_name: String
}>;
let orders_raw = parquet::read("benchmarking/data/tpch/parquet/orders.parquet") as DataFrame<{
    o_orderkey: Int64,
    o_orderstatus: String
}>;
let lineitem_raw = parquet::read("benchmarking/data/tpch/parquet/lineitem.parquet") as DataFrame<{
    l_orderkey: Int64,
    l_suppkey: Int64,
    l_commitdate: Date,
    l_receiptdate: Date
}>;

// Follow upstream PDS-H: restrict the outer late lines by nation and order
// status, then count distinct suppliers only for the remaining orders.
let waiting_lines = (
    (lineitem_raw[filter l_receiptdate > l_commitdate]
        join supplier_raw on { l_suppkey = s_suppkey })
        join nation_raw[filter n_name == "SAUDI ARABIA"]
            on { s_nationkey = n_nationkey }
) semi join orders_raw[filter o_orderstatus == "F"]
    on { l_orderkey = o_orderkey };

let relevant_lineitems = lineitem_raw semi join waiting_lines on { l_orderkey };
let multiple_suppliers = relevant_lineitems[distinct { l_orderkey, l_suppkey }][
    select { n_supp_by_order = count() }, by { l_orderkey }
][filter n_supp_by_order > 1];

let sole_late_supplier = relevant_lineitems[
    filter l_receiptdate > l_commitdate
][distinct { l_orderkey, l_suppkey }][
    select { n_supp_count = count() }, by { l_orderkey }
][filter n_supp_count == 1];

// Preserve the original line granularity: two late lines from the sole late
// supplier contribute two to numwait, rather than one supplier-level row.
let result = (
    (waiting_lines semi join multiple_suppliers on { l_orderkey })
        semi join sole_late_supplier on { l_orderkey }
)[
    select { numwait = count() }, by { s_name }
][
    order { numwait desc, s_name }, head 100
];
csv::write(result, "benchmarking/data/tpch/out/q21.csv");
result;
