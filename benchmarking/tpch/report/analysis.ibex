// PDS-H report: every number on the report, computed in Ibex.
//
// report.R finds each pass of each run it is given, loads every timing TSV of
// the pass with `load_timings`, binds them all as `timings`, then reads the
// tables below back into R to write and plot. A pass is one `run_bench.sh`
// invocation at one pinned core count; its TSVs hold one engine each, timed
// multi-threaded or (framework name ending in `-st`) single-threaded.
//
// Nothing here names an engine but Ibex: every other engine in the data is a
// reference, and "the faster reference" is the fastest of them per query.

import "csv";
import "json";

// One timing TSV of one pass, tagged with its run, its pass id, and the core
// count and scale factor from the pass's manifest.
fn load_timings(dir: String, file: String, run_label: String, pass_id: String) -> DataFrame {
    let n_cores = Int64(scalar(json::read(`${dir}/manifest.json`), cores));
    let sf = Int64(scalar(json::read(`${dir}/manifest.json`), scale_factor));
    csv::read(`${dir}/${file}`, "", "\t")[select { framework, query, ms = avg_ms }][update {
        engine = case {
            like(framework, "ibex%") => "Ibex",
            like(framework, "%duckdb%") => "DuckDB",
            like(framework, "%polars-stream%") => "Polars streaming",
            like(framework, "%polars%") => "Polars in-memory",
            else => framework
        },
        mode = case { like(framework, "%-st") => "single", else => "multi" },
        run = run_label,
        pass = pass_id,
        cores = n_cores,
        scale_factor = sf
    }];
}

// One row per (pass, reference engine, query): Ibex's milliseconds beside the
// reference's, for one thread mode.
fn against_references(t: DataFrame, threads: String) -> DataFrame {
    let ibex = t[filter engine == "Ibex" && mode == threads,
                 select { run, pass, cores, scale_factor, query, ibex = ms }];
    let refs = t[filter engine != "Ibex" && mode == threads,
                 select { run, pass, cores, query, reference = engine, reference_ms = ms }];
    (ibex join refs on { run, pass, cores, query })[update { ratio = ibex / reference_ms }];
}

// Per query: Ibex against the fastest reference engine.
fn per_query(t: DataFrame) -> DataFrame {
    let pairs = against_references(t, "multi");
    let fastest = pairs[select { faster_ms = min(reference_ms) }, by { run, pass, query }];
    let named = (pairs join fastest on { run, pass, query })[filter reference_ms == faster_ms,
                                                             select { run, pass, query, faster = reference }]
                [distinct { run, pass, query, faster }];
    ((pairs[select { ibex = first(ibex) }, by { run, pass, cores, scale_factor, query }]
         join fastest on { run, pass, query })
         join named on { run, pass, query })[update {
        vs_faster = ibex / faster_ms,
        ms_behind = ibex - faster_ms
    }][order { run, cores, pass, query }];
}

// Suite totals and geomeans of Ibex against each reference, per pass.
// `exclude` drops one query from every figure (pass "" to keep them all).
fn suite(t: DataFrame, threads: String, exclude: String) -> DataFrame {
    against_references(t, threads)[filter query != exclude, select {
        queries = count(),
        ibex_s = sum(ibex) / 1000.0,
        reference_s = sum(reference_ms) / 1000.0,
        geomean = exp(mean(log(ratio)))
    }, by { run, pass, cores, scale_factor, reference }][update {
        total_ratio = ibex_s / reference_s
    }][order { run, cores, pass, reference }];
}

// Against the fastest reference per query: the totals and geomean the
// headline quotes, per pass.
fn suite_vs_faster(t: DataFrame, exclude: String) -> DataFrame {
    per_query(t)[filter query != exclude, select {
        queries = count(),
        ibex_s = sum(ibex) / 1000.0,
        faster_s = sum(faster_ms) / 1000.0,
        geomean = exp(mean(log(vs_faster)))
    }, by { run, pass, cores, scale_factor }][update {
        total_ratio = ibex_s / faster_s
    }][order { run, cores, pass }];
}

// Every engine's suite total per pass, both thread modes.
fn totals(t: DataFrame) -> DataFrame {
    t[select { queries = count(), seconds = sum(ms) / 1000.0 },
      by { run, pass, cores, scale_factor, engine, mode }][order { run, cores, pass, engine, mode }];
}

// Single-core totals per run and engine. Every pass repeats the
// single-threaded rows on the same box, so a run's single-core time is the
// mean over its passes.
fn one_core(t: DataFrame) -> DataFrame {
    totals(t)[filter mode == "single", select {
        passes = count(),
        seconds = mean(seconds)
    }, by { run, scale_factor, engine }][order { run, engine }];
}

// Each engine's speedup over its own single-core time in the same run.
fn scaling(t: DataFrame) -> DataFrame {
    let multi = totals(t)[filter mode == "multi", select { run, pass, cores, engine, seconds }];
    let single = one_core(t)[select { run, engine, one_core_s = seconds }];
    (multi join single on { run, engine })[update {
        speedup = one_core_s / seconds
    }][select { run, pass, cores, engine, seconds, speedup }][order { run, cores, pass, engine }];
}
