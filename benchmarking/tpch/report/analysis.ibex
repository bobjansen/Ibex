// PDS-H AWS report: every number on the report, computed in Ibex.
//
// report.R unpacks the run archives, loads each pass with `load_pass`, binds
// them all as `timings`, then reads the tables below back into R and plots
// them with ggplot2. A pass is one `run_bench.sh` invocation at one pinned
// core count: Ibex, Polars streaming and DuckDB, each also single-threaded.

import "csv";
import "json";

// One engine's per-query timings (mean of the timed iterations) from one pass.
fn read_engine(path: String, eng: String, threads: String) -> DataFrame {
    csv::read(path, "", "\t")[select { query, ms = avg_ms }][update { engine = eng, mode = threads }];
}

// The six TSVs of one pass, tagged with its run, its pass id and the core
// count it was pinned to (from the pass's manifest).
fn load_pass(dir: String, run_label: String, pass_id: String) -> DataFrame {
    let n_cores = Int64(scalar(json::read(`${dir}/manifest.json`), cores));
    rbind(
        read_engine(`${dir}/ibex_sf10.tsv`, "Ibex", "multi"),
        read_engine(`${dir}/pdsh_polars_stream_sf10.tsv`, "Polars", "multi"),
        read_engine(`${dir}/pdsh_duckdb_sf10.tsv`, "DuckDB", "multi"),
        read_engine(`${dir}/ibex_st_sf10.tsv`, "Ibex", "single"),
        read_engine(`${dir}/pdsh_polars_stream_st_sf10.tsv`, "Polars", "single"),
        read_engine(`${dir}/pdsh_duckdb_st_sf10.tsv`, "DuckDB", "single")
    )[update { run = run_label, pass = pass_id, cores = n_cores }];
}

// One row per (run, pass, cores, query): the three engines' milliseconds side
// by side, for one thread mode.
fn engines_wide(t: DataFrame, threads: String) -> DataFrame {
    let ib = t[filter engine == "Ibex" && mode == threads,
               select { run, pass, cores, query, ibex = ms }];
    let pl = t[filter engine == "Polars" && mode == threads,
               select { run, pass, cores, query, polars = ms }];
    let dk = t[filter engine == "DuckDB" && mode == threads,
               select { run, pass, cores, query, duckdb = ms }];
    (ib join pl on { run, pass, cores, query }) join dk on { run, pass, cores, query };
}

// Per query: Ibex against each engine and against the faster of the two.
fn per_query(t: DataFrame) -> DataFrame {
    engines_wide(t, "multi")[update {
        faster_ms = pmin(polars, duckdb),
        faster = case { polars <= duckdb => "Polars", else => "DuckDB" },
        vs_faster = ibex / pmin(polars, duckdb),
        ms_behind = ibex - pmin(polars, duckdb)
    }];
}

// Suite totals and the ratios the report quotes, per pass. `exclude` drops one
// query from every figure (pass "" to keep all 22).
fn suite(t: DataFrame, threads: String, exclude: String) -> DataFrame {
    engines_wide(t, threads)[filter query != exclude, select {
        ibex_s = sum(ibex) / 1000.0,
        polars_s = sum(polars) / 1000.0,
        duckdb_s = sum(duckdb) / 1000.0,
        geomean_vs_polars = exp(mean(log(ibex / polars))),
        geomean_vs_duckdb = exp(mean(log(ibex / duckdb))),
        geomean_vs_faster = exp(mean(log(ibex / pmin(polars, duckdb))))
    }, by { run, pass, cores }][update {
        vs_polars = ibex_s / polars_s,
        vs_duckdb = ibex_s / duckdb_s
    }][order { run, cores, pass }];
}

// Single-core totals per run. Every pass repeats the single-threaded rows on
// the same box, so a run's single-core time is the mean over its passes and
// its ratio is taken over all of them.
fn one_core(t: DataFrame) -> DataFrame {
    engines_wide(t, "single")[select {
        passes = count_distinct(pass),
        ibex_ms = sum(ibex),
        polars_ms = sum(polars),
        duckdb_ms = sum(duckdb)
    }, by { run }][update {
        ibex_s = ibex_ms / 1000.0 / Float64(passes),
        polars_s = polars_ms / 1000.0 / Float64(passes),
        duckdb_s = duckdb_ms / 1000.0 / Float64(passes),
        vs_polars = ibex_ms / polars_ms,
        vs_duckdb = ibex_ms / duckdb_ms
    }][select { run, passes, ibex_s, polars_s, duckdb_s, vs_polars, vs_duckdb }];
}

// Each engine's speedup over its own single-core time on the same box.
fn scaling(t: DataFrame) -> DataFrame {
    let multi = suite(t, "multi", "");
    let single = one_core(t)[select { run, ibex1 = ibex_s, polars1 = polars_s, duckdb1 = duckdb_s }];
    (multi join single on { run })[update {
        speedup_ibex = ibex1 / ibex_s,
        speedup_polars = polars1 / polars_s,
        speedup_duckdb = duckdb1 / duckdb_s
    }][select { run, pass, cores, speedup_ibex, speedup_polars, speedup_duckdb }];
}

// The 8-core passes side by side, with and without q21: how well a ratio
// repeats across passes and boxes.
fn repeatability(t: DataFrame, n_cores: Int) -> DataFrame {
    let all = suite(t, "multi", "")[filter cores == n_cores,
                                    select { run, pass, ibex_s, polars_s, duckdb_s, vs_polars, vs_duckdb }];
    let no_q21 = suite(t, "multi", "q21")[filter cores == n_cores,
                                          select { run, pass, no_q21_vs_polars = vs_polars,
                                                   no_q21_vs_duckdb = vs_duckdb }];
    (all join no_q21 on { run, pass })[order { run, pass }];
}
