{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ibex",
  "scopeName": "source.ibex",
  "fileTypes": [
    "ibex"
  ],
  "comment": "Keywords mirror the lexer table in src/parser/lexer.cpp and editors/nvim/syntax/ibex.vim; keep the three in sync.",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#templates"
        },
        {
          "include": "#backtick-identifiers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#duration-literals"
        },
        {
          "include": "#numeric-literals"
        },
        {
          "include": "#type-keywords"
        },
        {
          "include": "#enums"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#clause-keywords"
        },
        {
          "include": "#join-keywords"
        },
        {
          "include": "#declaration-keywords"
        },
        {
          "include": "#control-keywords"
        },
        {
          "include": "#other-keywords"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ibex",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ibex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ibex"
            }
          }
        },
        {
          "name": "comment.line.double-slash.ibex",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ibex",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ibex",
          "match": "\\\\[\\\"\\\\nrt0]"
        },
        {
          "name": "invalid.illegal.escape.ibex",
          "match": "\\\\."
        }
      ]
    },
    "templates": {
      "comment": "A backtick string holding ${expr} is an interpolated String; without one it is a quoted identifier.",
      "name": "string.interpolated.ibex",
      "begin": "`(?=[^`\\n]*\\$\\{)",
      "end": "`|$",
      "patterns": [
        {
          "name": "meta.embedded.expression.ibex",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.ibex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.ibex"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "backtick-identifiers": {
      "name": "variable.other.quoted.ibex",
      "match": "`[^`\\n]*`"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ibex",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ibex",
          "match": "\\b(null|NULL)\\b"
        }
      ]
    },
    "duration-literals": {
      "comment": "Before numeric-literals so '1m' matches whole, not just '1'.",
      "name": "constant.numeric.duration.ibex",
      "match": "\\b[0-9]+(ns|us|ms|mo|[smhdwy])\\b"
    },
    "numeric-literals": {
      "name": "constant.numeric.ibex",
      "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
    },
    "type-keywords": {
      "name": "storage.type.ibex",
      "match": "\\b(Int|Int32|Int64|Float32|Float64|Bool|String|Date|Timestamp|Decimal|Series|Column|DataFrame|TimeFrame|Stream)\\b"
    },
    "enums": {
      "patterns": [
        {
          "name": "support.type.enum.ibex",
          "match": "\\b(RoundMode)\\b"
        },
        {
          "name": "support.constant.enum.ibex",
          "match": "\\b(Nearest|Bankers|Floor|Ceil|Trunc)\\b"
        }
      ]
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.other.declaration.ibex"
        },
        "2": {
          "name": "entity.name.function.ibex"
        }
      }
    },
    "clause-keywords": {
      "name": "keyword.control.clause.ibex",
      "match": "\\b(filter|select|update|distinct|order|head|tail|by|window|resample|rename|melt|dcast|cov|corr|transpose|model|map|in|where)\\b"
    },
    "join-keywords": {
      "name": "keyword.control.join.ibex",
      "match": "\\b(join|left|right|outer|semi|anti|cross|asof|on|suffix)\\b"
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.other.declaration.ibex",
          "match": "\\b(let|mut|extern|fn)\\b"
        },
        {
          "name": "keyword.control.import.ibex",
          "match": "\\b(import|from)\\b"
        }
      ]
    },
    "control-keywords": {
      "name": "keyword.control.conditional.ibex",
      "match": "\\b(case|else)\\b"
    },
    "other-keywords": {
      "patterns": [
        {
          "name": "keyword.other.direction.ibex",
          "match": "\\b(asc|desc)\\b"
        },
        {
          "name": "keyword.other.ibex",
          "match": "\\b(as|is|not)\\b"
        }
      ]
    },
    "namespaces": {
      "name": "entity.name.namespace.ibex",
      "match": "\\b[A-Za-z_]\\w*(?=::)"
    },
    "function-calls": {
      "name": "entity.name.function.call.ibex",
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ibex",
          "match": "->|=>"
        },
        {
          "name": "punctuation.separator.namespace.ibex",
          "match": "::"
        },
        {
          "name": "keyword.operator.logical.ibex",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.ibex",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.ibex",
          "match": "="
        },
        {
          "name": "keyword.operator.scope-escape.ibex",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.arithmetic.ibex",
          "match": "[+\\-*/%~]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.ibex",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.ibex",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.ibex",
          "match": "[()]"
        },
        {
          "name": "punctuation.accessor.ibex",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.ibex",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.ibex",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.ibex",
          "match": ";"
        }
      ]
    }
  }
}
