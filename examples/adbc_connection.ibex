// A reusable ADBC connection: one login, and session state (here a table in
// an in-memory SQLite database) that lasts across queries.
//
// Install the driver once:  scripts/install_adbc_driver.sh sqlite
// Run:                      ./build/tools/ibex --plugin-path build/tools examples/adbc_connection.ibex
//
// `import "adbc"` declares, among others:
//   extern type AdbcConnection from "adbc.hpp";
//   extern fn adbc_connect(driver: String, uri: String, options: String = "")
//       -> AdbcConnection from "adbc.hpp";
// A resource type such as AdbcConnection can be bound with `let`, passed to
// and returned from functions, but not stored in a column or inspected.

import "adbc";

let db = adbc_connect("sqlite", ":memory:");

// Each call runs on the same connection, so the table made here is still
// there for the queries below. read_adbc would open a fresh database each time.
adbc_query(db, "create table trades (symbol text, qty integer, px real)");
adbc_query(db, "insert into trades values ('AAPL', 10, 150.0), ('MSFT', 5, 300.0), ('AAPL', 20, 151.0)");

// A query result is an ordinary table operand.
adbc_query(db, "select symbol, qty, px from trades")[
    select { qty = sum(qty), notional = sum(qty * px) },
    by symbol,
    order symbol
];

// A function can take the connection. It shares the caller's connection, so
// it sees the same table; `mutable` records that the query uses its state.
fn positions(mutable conn: AdbcConnection) -> DataFrame {
    adbc_query(conn, "select symbol, sum(qty) as qty from trades group by symbol order by symbol");
}

positions(db)[filter qty > 5];

// A function can also open a connection of its own. It is closed when the
// function returns, even if a query in it fails; return the connection
// instead (`-> AdbcConnection`) to keep it open for the caller.
fn table_count(uri: String) -> DataFrame {
    let scratch = adbc_connect("sqlite", uri);
    adbc_query(scratch, "select count(*) as n from sqlite_master where type = 'table'");
}

table_count(":memory:");

// Closing is explicit and idempotent: 1 the first time, 0 after. A query on a
// closed connection is an error.
adbc_close(db);
