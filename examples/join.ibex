// Join examples (inner + left + right + outer + semi + anti + cross)

import "csv";

let iris = read_csv("data/iris.csv");
let species_meta = read_csv("data/iris.csv");

// Each result is truncated to 10 rows on display.

// Inner join on a single key
print("inner join on Species — only matching rows:");
iris join species_meta on Species;

// Mapped keys join differently named columns. Both key columns remain in the
// native Ibex output; same-name keys above are emitted only once.
let species_by_code = species_meta[rename SpeciesCode = Species];
print("inner join on mapped keys — Species matches SpeciesCode:");
iris join species_by_code on { Species = SpeciesCode };

// Left join on a single key
print("left join on Species — all left rows, nulls where unmatched:");
iris left join species_meta on Species;

// Right join on a single key
print("right join on Species — all right rows:");
iris right join species_meta on Species;

// Full outer join on a single key
print("outer join on Species — union of both sides:");
iris outer join species_meta on Species;

// Semi join keeps only matching left rows
print("semi join on Species — left rows that have a match (no right columns):");
iris semi join species_meta on Species;

// Anti join keeps only non-matching left rows
print("anti join on Species — left rows with no match:");
iris anti join species_meta on Species;

// Cross join returns the cartesian product
print("cross join — cartesian product of both sides:");
iris cross join species_meta;

// A non-equijoin predicate compares columns across the two inputs. Both sides
// here come from the same file, so every name exists twice — `left(...)` and
// `right(...)` say which input is meant. A bare name would be ambiguous and is
// rejected rather than resolved by a rule you would have to remember.
print("non-equijoin — flowers wider than the row they are paired with:");
iris[filter Species == "setosa"]
    join species_meta[filter Species == "virginica"]
    on left(`Sepal.Width`) > right(`Sepal.Width`)
       && left(`Petal.Length`) < right(`Petal.Length`);
