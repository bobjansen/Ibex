// Join examples (inner + left + right + outer + semi + anti + cross)

import "csv";

let iris = read_csv("data/iris.csv");
let species_meta = read_csv("data/iris.csv");

// Each result is truncated to 10 rows on display.

// Inner join on a single key
// Both inputs are the same file, so every non-key column exists on both
// sides. Ibex will not guess a name for a clash: the `suffix` clause says
// what to call each side, and without it the join is an error.
print("inner join on Species — only matching rows:");
iris join species_meta on Species suffix { "", "_meta" };

// Mapped keys join differently named columns. Both key columns remain in the
// native Ibex output; same-name keys above are emitted only once.
let species_by_code = species_meta[rename SpeciesCode = Species];
print("inner join on mapped keys — Species matches SpeciesCode:");
iris join species_by_code on { Species = SpeciesCode } suffix { "", "_meta" };

// Left join on a single key
print("left join on Species — all left rows, nulls where unmatched:");
iris left join species_meta on Species suffix { "", "_meta" };

// Right join on a single key
print("right join on Species — all right rows:");
iris right join species_meta on Species suffix { "", "_meta" };

// Full outer join on a single key
print("outer join on Species — union of both sides:");
iris outer join species_meta on Species suffix { "", "_meta" };

// Semi join keeps only matching left rows
print("semi join on Species — left rows that have a match (no right columns):");
iris semi join species_meta on Species;

// Anti join keeps only non-matching left rows
print("anti join on Species — left rows with no match:");
iris anti join species_meta on Species;

// Cross join returns the cartesian product
print("cross join — cartesian product of both sides:");
iris cross join species_meta suffix { "", "_meta" };

// A non-equijoin predicate compares columns across the two inputs. Both sides
// here come from the same file, so every name exists twice — `left(...)` and
// `right(...)` say which input is meant. A bare name would be ambiguous and is
// rejected rather than resolved by a rule you would have to remember.
print("non-equijoin — flowers wider than the row they are paired with:");
iris[filter Species == "setosa"]
    join species_meta[filter Species == "virginica"]
    on left(`Sepal.Width`) > right(`Sepal.Width`)
       && left(`Petal.Length`) < right(`Petal.Length`)
    suffix { "", "_other" };

// An empty suffix leaves that side alone, as above. Naming both sides is the
// other common shape — useful when neither input is the "original".
print("both sides renamed — neither input is privileged:");
iris[head 3] join species_meta[head 3] on Species suffix { "_a", "_b" };

// Semi and anti joins emit no right columns, so nothing can collide and no
// clause is needed — see the two examples above.

// ── Null keys ─────────────────────────────────────────────────────────────
// A null key matches nothing by default — not even another null. That is the
// same rule `filter x == y` follows, and deliberately unlike `by`, where nulls
// do group together.
//
// One row per species, left joined to a lookup that only knows about setosa,
// so `region` is a real null on the other two rows.
let species = iris[distinct { Species }][order { Species asc }];
let regions = Table { Species = ["setosa"], region = ["north"] };
let with_region = species left join regions on Species;
print("region is null wherever the lookup missed:");
with_region;

// The same three rows again, to join back on that nullable column.
let sites = with_region[select { region, site = Species }];

// By default the two null-keyed rows on each side find nothing, so only the
// setosa/north pair survives.
print("default — a null key matches nothing:");
with_region join sites on region;

// `nulls equal` asks for the other behaviour by name: each null row now pairs
// with each null row on the other side, and never with a present value.
print("nulls equal — nulls pair with nulls, and only with nulls:");
with_region join sites on region nulls equal;

// ── Declared cardinality ──────────────────────────────────────────────────
// A join can state how its rows are expected to line up. The left term is how
// many left rows may match one right row, the right term how many right rows
// may match one left row — so `n:1` reads "many measurements, one species".
//
// It is checked against the pairs actually emitted, and a run whose data
// disagrees fails rather than fanning out silently.
print("n:1 — many iris rows per species, one species row per iris row:");
iris[head 6] join species_by_code[distinct { SpeciesCode }] on { Species = SpeciesCode } expect n:1;

// The same join declared 1:1 is a lie: three iris rows share each species.
// Uncomment to see it fail —
//   iris[head 6] join species_by_code[distinct { SpeciesCode }]
//       on { Species = SpeciesCode } expect 1:1;
