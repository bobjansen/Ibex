namespace parquet {

// Read a Parquet file into a DataFrame.
// Uses the bundled parquet plugin and preserves supported column types.
extern fn read(path: String) -> DataFrame from "parquet.hpp";

// Write a DataFrame to a Parquet file.
// Returns the number of rows written.
extern fn write(df: DataFrame, path: String, compression: String = "zstd",
                compression_level: Int = 3, row_group_size: Int = 122880,
                statistics: Bool = true) -> Int from "parquet.hpp";

}
