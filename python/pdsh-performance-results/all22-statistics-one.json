  "statistics_method": "Median paired Ibex/streaming ratios; exact two-sided signed-rank sign enumeration, omitting zero differences and averaging tied absolute ranks. P values are unadjusted across queries. Six rounds provide only a broad comparison; small gaps are not established wins.",
  "measurement_overrides": {
    "q09": {
      "source_report": "all22-one-q09-rerun.json",
      "original_report": "all22-one-original.json",
      "reason": "The original Q9 samples coincided with observed host load above 30 and inflated all three routes. The complete six-round Q9 comparison was repeated in a fresh process after load settled below 2; no individual samples were selected."
    }
  },
  "driver": "from pathlib import Path\nimport json,statistics,math,itertools\n\ndef signed_rank_p(before,after):\n    ds=[a-b for a,b in zip(after,before) if a!=b]\n    order=sorted(range(len(ds)),key=lambda i:abs(ds[i]));ranks=[0.]*len(ds)\n    i=0\n    while i<len(ds):\n        j=i+1\n        while j<len(ds) and abs(ds[order[j]])==abs(ds[order[i]]):j+=1\n        for k in order[i:j]:ranks[k]=(i+1+j)/2\n        i=j\n    observed=abs(sum(r if d>0 else -r for r,d in zip(ranks,ds)))\n    if not ds:return 1.\n    return sum(abs(sum(s*r for s,r in zip(ss,ranks)))>=observed for ss in itertools.product((-1,1),repeat=len(ds)))/(2**len(ds))\n\ndef summarize(path):\n    d=json.loads(Path(path).read_text());assert len(d['queries'])==22 and all(q['status']=='passed' for q in d['queries'].values())\n    qs=d['queries'];r={};totals={k:sum(q['median_ms'][k] for q in qs.values()) for k in ('polars','polars_streaming','polars_ibex')}\n    for name,q in qs.items():\n        ratios=[a/b for a,b in zip(q['samples_ms']['polars_ibex'],q['samples_ms']['polars_streaming'])]\n        r[name]={'median_ms':q['median_ms'],'median_cpu_ms':q['median_cpu_ms'],'paired_ibex_over_streaming':statistics.median(ratios),'signed_rank_p_unadjusted':signed_rank_p(q['samples_ms']['polars_streaming'],q['samples_ms']['polars_ibex']),'ibex_faster_pairs':sum(x<1 for x in ratios)}\n    return {'git_head':d['git_head'],'threads':d['ibex_cores'],'total_of_query_medians_ms':totals,'geomean_ibex_over_streaming':math.exp(statistics.mean(math.log(q['median_ms']['polars_ibex']/q['median_ms']['polars_streaming']) for q in qs.values())),'geomean_ibex_over_in_memory':math.exp(statistics.mean(math.log(q['median_ms']['polars_ibex']/q['median_ms']['polars']) for q in qs.values())),'ibex_lower_median_than_streaming':sum(q['median_ms']['polars_ibex']<q['median_ms']['polars_streaming'] for q in qs.values()),'ibex_lower_median_than_in_memory':sum(q['median_ms']['polars_ibex']<q['median_ms']['polars'] for q in qs.values()),'queries':r}\n\ndef table(s):\n    lines=['| Query | Polars in-memory | Polars streaming | Polars\u2013Ibex | Ibex / streaming |','|---|---:|---:|---:|---:|']\n    for n,q in s['queries'].items():\n        v=q['median_ms'];lines.append(f\"| {n.upper()} | {v['polars']:,.1f} | {v['polars_streaming']:,.1f} | {v['polars_ibex']:,.1f} | {v['polars_ibex']/v['polars_streaming']:.2f}\u00d7 |\")\n    return '\\n'.join(lines)\n\nif __name__=='__main__':\n    import sys\n    s=summarize(sys.argv[1]);Path(sys.argv[2]).write_text(json.dumps(s,indent=2)+'\\n');print(table(s));print(json.dumps({k:v for k,v in s.items() if k!='queries'},indent=2))\n"
}
