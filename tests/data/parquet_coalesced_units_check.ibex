extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";

// Streaming units that span several row groups: see
// gen_parquet_coalesced_units.py for the file's shape (320 row groups, 64 units
// of five groups each). A selection or page stripe mapped back to the wrong
// rows moves the per-k totals; parquet_coalesced_units_totals.ibex covers the
// plain decode.
//
// One statement per script: in a multi-statement script the scan is decoded
// whole and never touches a unit.
let fact = read_parquet("tests/data/parquet_coalesced_units_out.parquet");
fact[
    filter like(s, "%needle%") && id >= 12345,
    select { hits = count(), hit_total = sum(id) },
    by { k },
    order { k }
];
