extern fn write_parquet(df: DataFrame, path: String) -> Int from "parquet.hpp";
extern fn read_parquet(path: String) -> DataFrame from "parquet.hpp";

// A fixed-width, null-free column is decoded one ROW GROUP per worker: each
// range's output row count is known from the footer before anything is decoded,
// so each range writes its own slice of a buffer allocated up front.
//
// This file has two row groups — Parquet's max_row_group_length is 1048576 rows
// regardless of the chunk size write_parquet asks for, so 1,300,000 rows split
// 1048576 / 251424 — and one column of each type that takes the split path.
//
// The aggregates below are order-independent on purpose. What they catch is a
// range writing to the WRONG PLACE: a shard that starts at the wrong offset
// leaves the rows it should have written uninitialized and overwrites rows that
// were already correct, which moves every one of these sums. The single- and
// multi-threaded runs are then also required to agree byte for byte, which is
// the property the split is supposed to have — the same bytes as a serial
// decode, not merely the same answer.
let base = Table(1300000)[update {
    one = rep([1], length_out = 1300000),
    d = rep([0.5, 1.25, 2.0, 4.75], length_out = 1300000),
    day = rep([date"1994-01-01", date"1995-06-15", date"1996-12-31"], length_out = 1300000),
    at = rep([ts"1994-01-01T00:00:00Z", ts"1995-06-15T12:30:00Z"], length_out = 1300000)
}];
let facts = base[update { k = rank(one, method = first) }];
write_parquet(facts, "tests/data/parquet_row_group_decode_out.parquet");

// Expected: 1300000 / 845000650000 / 1 / 1300000 / 2762500 / 433334 / 433333 /
// 650000. k is 1..1300000 so sum(k) = n(n+1)/2, and the rest follow from the
// rep() cycle lengths.
//
// Date and Timestamp are counted through an indicator rather than min/max,
// which the aggregate does not take for those types.
read_parquet("tests/data/parquet_row_group_decode_out.parquet")[
    select {
        rows = count(),
        k_total = sum(k),
        k_lo = min(k),
        k_hi = max(k),
        d_total = sum(d),
        day_first = sum(Int64(day == date"1994-01-01")),
        day_last = sum(Int64(day == date"1996-12-31")),
        at_first = sum(Int64(at == ts"1994-01-01T00:00:00Z"))
    }
];
