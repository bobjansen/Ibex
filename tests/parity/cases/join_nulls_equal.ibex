// `nulls equal` makes a null key match exactly the nulls on the other side.
// Both inputs get their nulls from a left join rather than a literal, which
// also gives each side a GENUINE 0 in the same column: a null cell holds its
// type's zero, so a test whose keys avoid 0 would pass even if the two were
// conflated. Here id 3 carries a real 0 on both sides and must pair only with
// the other real 0, while the null-keyed ids 2 and 4 pair with each other --
// four such pairs, which is also what tells this apart from "nulls pass
// through unmatched".
let ids = Table { id = [1, 2, 3, 4] };
let lmap = Table { id = [1, 3], k = [7, 0] };
let rmap = Table { id = [1, 3], k = [7, 0] };

let l = (ids left join lmap on id)[select { lid = id, k }];
let r = (ids left join rmap on id)[select { rid = id, k }];

(l join r on k nulls equal)[order { lid asc, rid asc }];
