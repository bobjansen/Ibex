let l = Table {
    id = [1, 2, 3],
    val = [10, 20, 30],
    val_right = [11, 21, 31]
};
let r = Table {
    id = [2, 3, 4],
    val = [200, 300, 400]
};
// "val" collides, and so does the "val_right" that renaming it would produce,
// so the right column ends up as "val_right_right".
let j = l left join r on id;
j[select { id, val, val_right, val_right_right }][order { id asc }];
