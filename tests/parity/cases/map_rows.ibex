// Row-wise `map { }` clause (SPEC 5.3). Pure — no plugins — so the parity
// harness runs it without a plugin search path.
//
// Input row order is the output order here.
let t = Table {
    n = [1, 2, 3, 4],
    label = ["a", "b", "c", "d"]
};

t[map {
    doubled = n * 2,
    parity = n % 2,
    tag = label
}];
