// A `fn` that opens a connection and returns it (kept open for the caller), one
// that returns its argument, one that runs a statement on a connection and returns
// the count, and one that calls another. The connection a function returns is the
// caller's: what it wrote is read back through it.
import "adbc";

fn opened(uri: String) -> adbc::Connection {
    adbc::connect("@SQLITE_DRIVER@", uri);
}

fn same(c: adbc::Connection) -> adbc::Connection {
    c;
}

fn add_row(mutable conn: adbc::Connection, v: Int) -> Int {
    adbc::execute(conn, "insert into t values (100)");
}

fn add_twice(mutable conn: adbc::Connection) -> Int {
    add_row(conn, 1);
}

let db = opened("file:/tmp/ibex_parity_adbc_function_connection.db");
adbc::execute(db, "create table t (x integer)");
let kept = same(db);
let first = add_twice(kept);
let second = add_row(db, 2);
adbc::query(kept, "select count(*) as n, sum(x) as total from t");
