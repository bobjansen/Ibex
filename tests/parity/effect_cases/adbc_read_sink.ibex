// A database read feeding a sink, then read back: the ADBC source and the effect
// ordering work together in a compiled program.
import "adbc";
import "csv";
let rows = adbc::read("@SQLITE_DRIVER@", "", "select 4 as x union all select 5 union all select 6");
csv::write(rows, "/tmp/ibex_parity_adbc_read_sink.csv");
let back = csv::read("/tmp/ibex_parity_adbc_read_sink.csv");
back[select { total = sum(x) }];
