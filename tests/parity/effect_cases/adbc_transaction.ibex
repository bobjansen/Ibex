// A transaction across statements of one connection: what is rolled back is gone,
// what is committed stays.
import "adbc";
let db = adbc::connect("@SQLITE_DRIVER@", "file:/tmp/ibex_parity_adbc_transaction.db");
adbc::execute(db, "create table t (x integer)");
adbc::begin(db);
adbc::execute(db, "insert into t values (1)");
adbc::rollback(db);
let after_rollback = adbc::query(db, "select count(*) as n from t");
adbc::begin(db);
adbc::execute(db, "insert into t values (2), (3)");
adbc::commit(db);
let after_commit = adbc::query(db, "select count(*) as n from t");
rbind(after_rollback, after_commit);
