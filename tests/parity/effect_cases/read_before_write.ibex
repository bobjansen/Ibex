// `r` reads the file before a later statement replaces it, and is used once, so
// it would be inlined into the sink after the write. It must see the old file.
import "csv";
let old = Table { x = [1, 2] };
csv::write(old, "/tmp/ibex_parity_read_before_write.csv");
let r = csv::read("/tmp/ibex_parity_read_before_write.csv")[select { s = sum(x) }];
let fresh = Table { x = [10, 20] };
csv::write(fresh, "/tmp/ibex_parity_read_before_write.csv");
csv::write(r, "/tmp/ibex_parity_read_before_write_out.csv");
csv::read("/tmp/ibex_parity_read_before_write_out.csv");
