// `r` reads the file before a later statement replaces it, and is used once, so
// it would be inlined into the sink after the write. It must see the old file.
import "csv";
let old = Table { x = [1, 2] };
write_csv(old, "/tmp/ibex_parity_read_before_write.csv");
let r = read_csv("/tmp/ibex_parity_read_before_write.csv")[select { s = sum(x) }];
let fresh = Table { x = [10, 20] };
write_csv(fresh, "/tmp/ibex_parity_read_before_write.csv");
write_csv(r, "/tmp/ibex_parity_read_before_write_out.csv");
read_csv("/tmp/ibex_parity_read_before_write_out.csv");
