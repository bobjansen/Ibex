// `r` is read twice, so it is shared. The shared binding must run where its
// `let` is -- after the write that replaces the file -- not before every sink.
import "csv";
let old = Table { x = [1, 2] };
csv::write(old, "/tmp/ibex_parity_shared_binding_after_write.csv");
let fresh = Table { x = [10, 20] };
csv::write(fresh, "/tmp/ibex_parity_shared_binding_after_write.csv");
let r = csv::read("/tmp/ibex_parity_shared_binding_after_write.csv")[select { total = sum(x) }];
let lo = r[filter total > 0];
let hi = r[filter total > 1];
lo join hi on total;
